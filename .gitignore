# Documentation: README.md at the repository root is the only tracked Markdown file
*.md
!/README.md

# Python environments
.venv/
venv/
env/
.python-version

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# macOS metadata
.DS_Store
._*

# Hugging Face caches and downloaded model weights
.cache/
huggingface/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Generated training/evaluation outputs (adapters, checkpoints, traces, logs, figures)
outputs/
*.log
wandb/
runs/

# Scratch and temporary files
scratch/
tmp/
*.tmp
*.swp

# Credentials and secrets
.env
.env.*
*.pem
*.key
.netrc

# Local editor / machine configuration
.vscode/
.idea/

# Study write-ups (explicitly tracked besides README.md)
!/PILOT_FINAL_STATUS.md
!/REPORT.md
!/PRESENTATION_OUTLINE.md
!/reports/*.md

# Submission package and report built by run_final_analysis.sh (kept out of the public repository)
/submission/
/searchlite_rl_submission.zip
!/reports/FINAL_PILOT_REPORT.template.md
